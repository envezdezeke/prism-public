# Copy to .env (gitignored) and fill in. Never commit .env.
NVIDIA_API_KEY=nvapi-REPLACE_ME
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_AGENT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NEMOTRON_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_VL_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NEMOTRON_VL_FALLBACK_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NEMOTRON_TINY_MODEL=nvidia/nemotron-3.5-bolt-e4b
# off | replay | live
NEMOTRON_MODE=live
